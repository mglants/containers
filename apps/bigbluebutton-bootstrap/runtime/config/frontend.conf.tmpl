worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
 include /etc/nginx/mime.types;
 default_type application/octet-stream;
 {{if .Configured}}resolver {{.Resolver}} valid=5s ipv6=off;
 resolver_timeout 5s;
 {{range .Upstreams}}upstream {{.Name}} { zone {{.Name}} 64k; server {{.Address}} resolve; }
 {{end}}{{end}}
 log_format bbb_requests '$remote_addr $request_method $uri $status';
 access_log /dev/stdout bbb_requests;
 sendfile on;
 client_body_temp_path /tmp/client-body;
 proxy_temp_path /tmp/proxy;
 fastcgi_temp_path /tmp/fastcgi;
 uwsgi_temp_path /tmp/uwsgi;
 scgi_temp_path /tmp/scgi;
 {{if .Configured}}proxy_cache_path /tmp/bbb-cache keys_zone=client_settings_cache:10m inactive=24h;{{end}}
 server {
  listen {{.HTTPPort}};
  {{if .TLS}}listen {{.TLSPort}} ssl;
  ssl_certificate {{.Cert}};
  ssl_certificate_key {{.Key}};{{end}}
  server_name {{.ServerName}};
  absolute_redirect off;
  set $real_scheme {{.Scheme}};
  set $bbb_cors_origin '';
  set $bbb_loadbalancer_node '';
  proxy_set_header X-Forwarded-Proto {{.Scheme}};
  proxy_set_header Host $http_host;
  location = /healthz { return 200 "ok\n"; }
  {{if .Landing}}location = / { root {{.LandingDir}}; try_files {{.LandingURI}} =404; default_type text/html; add_header Cache-Control "no-store"; }
  {{else}}location = / { return 302 /html5client/; }{{end}}
  {{if .Configured}}location / { root /var/www/bigbluebutton-default/assets; }
  location /plugins/ { proxy_pass http://bbb-plugins/; }
  location /bigbluebutton/api/hooks/ { proxy_pass http://bbb-webhooks; }
  location /playback/video/ { alias /presentations/published/video/; index index.html; }
  include /usr/share/bbb-container/nginx/*.nginx;
  {{else}}location /html5client/ { alias /usr/share/bigbluebutton/html5-client/; index index.html; }
  location /learning-dashboard/ { alias /var/bigbluebutton/learning-dashboard/; index index.html; }{{end}}
 }
 {{if .Greenlight}}server {
  listen {{.GreenlightPort}} ssl;
  server_name {{.ServerName}};
  ssl_certificate {{.Cert}};
  ssl_certificate_key {{.Key}};
  location / {
   proxy_pass http://bbb-greenlight;
   proxy_set_header Host $http_host;
   proxy_set_header X-Forwarded-Proto https;
   proxy_set_header X-Forwarded-Port {{.GreenlightPublicPort}};
   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
   proxy_set_header Upgrade $http_upgrade;
   proxy_set_header Connection "upgrade";
  }
 }{{end}}
}
